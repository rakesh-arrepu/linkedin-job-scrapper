# LinkedIn Job Scraper Configuration

# Scraping Settings
MAX_JOBS=50
DELAY_BETWEEN_REQUESTS=3
PAGE_LOAD_TIMEOUT=30
HEADLESS_MODE=true

# Browser Settings
BROWSER_WINDOW_WIDTH=1920
BROWSER_WINDOW_HEIGHT=1080
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Output Settings
OUTPUT_DIR=./output
DEFAULT_OUTPUT_FORMAT=pdf
INCLUDE_TIMESTAMPS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=scraper.log

# Rate Limiting
MIN_DELAY=2
MAX_DELAY=5
RANDOM_DELAY=true

# LinkedIn Settings (Optional)
# LINKEDIN_EMAIL=your.email@example.com
# LINKEDIN_PASSWORD=your_password
# Note: Authentication is optional and not recommended for security

# Scraper Method Configuration
# Options: 'selenium' (browser-based) or 'api' (API-based, faster & more reliable)
SCRAPER_METHOD=api

# API Configuration (when SCRAPER_METHOD=api)
# RapidAPI LinkedIn Jobs API
# Get your API key from: https://rapidapi.com/letscrape-6bRBa3QguO5/api/linkedin-data-api
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=linkedin-data-api.p.rapidapi.com

# Alternative: JSSearch API (free tier available)
# Get your API key from: https://rapidapi.com/jsearch/api/jsearch
# JSEARCH_API_KEY=your_jsearch_key_here
# JSEARCH_API_HOST=jsearch.p.rapidapi.com

# Alternative: LinkedIn API Scraper (another option)
# LINKEDIN_API_KEY=your_api_key_here
